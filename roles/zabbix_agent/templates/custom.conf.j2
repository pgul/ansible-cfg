# {{ ansible_managed }}
# Manual edits will be overwritten. Change host_vars/{{ inventory_hostname }}.yml.
{% for name, port in zabbix_agent_rpc_checks | dictsort %}
UserParameter={{ name }}[*],/usr/local/bin/zbx-crypto-rpc "{{ name }}" "$1" "$2"
{% endfor %}
{% for line in zabbix_agent_user_parameters %}
UserParameter={{ line }}
{% endfor %}
