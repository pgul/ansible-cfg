#! /bin/sh

OUT=/var/tmp/updates-system

apt-get upgrade --dry-run --quiet=2 >"$OUT.new" 2>/dev/null
RC=$?
[ -f "$OUT" -a ! -w "$OUT" ] && rm -rf "$OUT"
mv "$OUT.new" "$OUT"
[ "$RC" = 1 ] && exit 1
RES=0
#[ -s "$OUT" ] && RES=1

zabbix_sender -c /etc/zabbix/zabbix_agentd.conf -k "system.updates" -o "$RES" >/dev/null
